COMPOSE_PROJECT_NAME=flowops-ai

APP_NAME="FlowOps AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=flowops_ai
DB_USERNAME=flowops
DB_PASSWORD=change-me
DB_SSLMODE=prefer

POSTGRES_DB=flowops_ai
POSTGRES_USER=flowops
POSTGRES_PASSWORD=change-me
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --data-checksums

CACHE_STORE=redis
CACHE_PREFIX=flowops_ai_cache
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=flowops_ai_database_

QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=flowops_ai_session

FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=operations@example.com
MAIL_FROM_NAME="FlowOps AI"

SANCTUM_STATEFUL_DOMAINS=localhost:8080
SANCTUM_TOKEN_PREFIX=flowops_
TRUSTED_PROXIES=*

IP_GEOLOCATION_ENABLED=false
IP_GEOLOCATION_PROVIDER=ipwhois
IP_GEOLOCATION_QUEUE=security
IP_GEOLOCATION_CACHE_STORE=redis
IP_GEOLOCATION_CACHE_TTL_SECONDS=604800
IP_GEOLOCATION_NEGATIVE_CACHE_TTL_SECONDS=3600
IP_GEOLOCATION_BASE_URL=https://ipwho.is
IP_GEOLOCATION_TIMEOUT_SECONDS=4
IP_GEOLOCATION_CONNECT_TIMEOUT_SECONDS=2
